@startuml School Management System ER Diagram

!define TABLE entity
!define PK <<PK>>
!define FK <<FK>>
!define UNIQUE <<unique>>

title School Management System - Entity Relationship Diagram

' User Management Module
package "User Management" {
    entity "USERS" as users {
        PK UserID : INT
        UNIQUE Username : VARCHAR(50)
        UNIQUE Email : VARCHAR(100)
        Password : VARCHAR(255)
        Phone : VARCHAR(15)
        FK RoleID : INT
        Status : ENUM('Active', 'Inactive', 'Pending')
        CreatedDate : TIMESTAMP
    }

    entity "ROLES" as roles {
        PK RoleID : INT
        UNIQUE RoleName : VARCHAR(50)
        Description : TEXT
    }

    entity "OTP_VERIFICATION" as otp {
        PK OTPID : INT
        FK UserID : INT
        OTP : VARCHAR(6)
        ExpiryTime : TIMESTAMP
        IsUsed : BOOLEAN
    }
}

' Student Management Module
package "Student Management" {
    entity "STUDENTS" as students {
        PK StudentID : INT
        FK UserID : INT
        FirstName : VARCHAR(50)
        LastName : VARCHAR(50)
        DateOfBirth : DATE
        Gender : ENUM('Male', 'Female', 'Other')
        Grade : VARCHAR(10)
        Section : VARCHAR(10)
        AdmissionDate : DATE
        Status : ENUM('Active', 'Inactive', 'Graduated')
    }

    entity "PARENTS" as parents {
        PK ParentID : INT
        FK UserID : INT
        FirstName : VARCHAR(50)
        LastName : VARCHAR(50)
        Phone : VARCHAR(15)
        Email : VARCHAR(100)
        Address : TEXT
        Occupation : VARCHAR(100)
    }

    entity "STUDENT_PARENT" as student_parent {
        FK StudentID : INT
        FK ParentID : INT
        Relationship : VARCHAR(50)
    }
}

' Teacher Management Module
package "Teacher Management" {
    entity "TEACHERS" as teachers {
        PK TeacherID : INT
        FK UserID : INT
        FirstName : VARCHAR(50)
        LastName : VARCHAR(50)
        Subject : VARCHAR(100)
        Department : VARCHAR(100)
        Phone : VARCHAR(15)
        Email : VARCHAR(100)
        Qualification : VARCHAR(200)
    }

    entity "CLASSES" as classes {
        PK ClassID : INT
        ClassName : VARCHAR(100)
        Grade : VARCHAR(10)
        Section : VARCHAR(10)
        FK TeacherID : INT
        AcademicYear : VARCHAR(10)
    }
}

' Attendance Management Module
package "Attendance Management" {
    entity "ATTENDANCE" as attendance {
        PK AttendanceID : INT
        FK StudentID : INT
        FK ClassID : INT
        Date : DATE
        Status : ENUM('Present', 'Absent', 'Late', 'Excused')
        FK MarkedBy : INT
        MarkedTime : TIMESTAMP
        Remarks : TEXT
    }

    entity "ATTENDANCE_REPORTS" as attendance_reports {
        PK ReportID : INT
        FK StudentID : INT
        Month : INT
        Year : INT
        TotalDays : INT
        PresentDays : INT
        AbsentDays : INT
        Percentage : DECIMAL(5,2)
    }
}

' Examination Management Module
package "Examination Management" {
    entity "SUBJECTS" as subjects {
        PK SubjectID : INT
        SubjectName : VARCHAR(100)
        SubjectCode : VARCHAR(20)
        Grade : VARCHAR(10)
        Credits : INT
    }

    entity "EXAMINATIONS" as examinations {
        PK ExamID : INT
        ExamName : VARCHAR(100)
        ExamType : VARCHAR(50)
        AcademicYear : VARCHAR(10)
        StartDate : DATE
        EndDate : DATE
        Status : ENUM('Scheduled', 'Ongoing', 'Completed')
    }

    entity "MARKS" as marks {
        PK MarkID : INT
        FK StudentID : INT
        FK ExamID : INT
        FK SubjectID : INT
        MarksObtained : DECIMAL(5,2)
        TotalMarks : DECIMAL(5,2)
        Grade : VARCHAR(5)
        Remarks : TEXT
        FK EnteredBy : INT
        EnteredDate : TIMESTAMP
    }

    entity "TIMETABLE" as timetable {
        PK TimetableID : INT
        FK ClassID : INT
        FK SubjectID : INT
        FK TeacherID : INT
        Day : VARCHAR(10)
        StartTime : TIME
        EndTime : TIME
        Room : VARCHAR(20)
        FK HallID : INT
    }

    entity "HALLS" as halls {
        PK HallID : INT
        HallName : VARCHAR(100)
        Capacity : INT
        Location : VARCHAR(200)
        Facilities : TEXT
    }
}

' Transport Management Module
package "Transport Management" {
    entity "ROUTES" as routes {
        PK RouteID : INT
        RouteName : VARCHAR(100)
        StartLocation : VARCHAR(200)
        EndLocation : VARCHAR(200)
        Distance : DECIMAL(8,2)
        Fare : DECIMAL(10,2)
        Status : ENUM('Active', 'Inactive')
    }

    entity "SHUTTLES" as shuttles {
        PK ShuttleID : INT
        FK RouteID : INT
        VehicleNumber : VARCHAR(20)
        DriverName : VARCHAR(100)
        DriverPhone : VARCHAR(15)
        Capacity : INT
        Status : ENUM('Active', 'Inactive', 'Maintenance')
    }

    entity "STUDENT_TRANSPORT" as student_transport {
        FK StudentID : INT
        FK RouteID : INT
        FK ShuttleID : INT
        PickupTime : TIME
        DropTime : TIME
        Status : ENUM('Active', 'Inactive')
    }

    entity "LOCATION_TRACKING" as location_tracking {
        PK TrackingID : INT
        FK ShuttleID : INT
        Latitude : DECIMAL(10,8)
        Longitude : DECIMAL(11,8)
        Timestamp : TIMESTAMP
        Speed : DECIMAL(5,2)
    }
}

' Notification Management Module
package "Notification Management" {
    entity "NOTIFICATIONS" as notifications {
        PK NotificationID : INT
        Title : VARCHAR(200)
        Message : TEXT
        Type : ENUM('Attendance', 'Exam', 'General', 'Transport')
        FK CreatedBy : INT
        CreatedDate : TIMESTAMP
        Priority : ENUM('Low', 'Medium', 'High')
        Status : ENUM('Active', 'Inactive')
    }

    entity "NOTIFICATION_RECIPIENTS" as notification_recipients {
        FK NotificationID : INT
        FK UserID : INT
        IsRead : BOOLEAN
        ReadDate : TIMESTAMP
    }

    entity "ANNOUNCEMENTS" as announcements {
        PK AnnouncementID : INT
        Title : VARCHAR(200)
        Content : TEXT
        FK CreatedBy : INT
        CreatedDate : TIMESTAMP
        ExpiryDate : DATE
        Category : VARCHAR(50)
    }
}

' Relationships
users ||--|| students : "has"
users ||--|| parents : "has"
users ||--|| teachers : "has"
users ||--o{ roles : "belongs to"
users ||--o{ otp : "verifies with"

students ||--o{ student_parent : "linked to"
parents ||--o{ student_parent : "linked to"

teachers ||--o{ classes : "teaches"
students ||--o{ classes : "belongs to"

students ||--o{ attendance : "has"
classes ||--o{ attendance : "tracks"
teachers ||--o{ attendance : "marks"
students ||--o{ attendance_reports : "generates"

students ||--o{ marks : "receives"
examinations ||--o{ marks : "contains"
subjects ||--o{ marks : "evaluated in"
teachers ||--o{ marks : "enters"

classes ||--o{ timetable : "scheduled in"
subjects ||--o{ timetable : "taught in"
teachers ||--o{ timetable : "teaches in"
halls ||--o{ timetable : "conducted in"

routes ||--o{ shuttles : "served by"
students ||--o{ student_transport : "uses"
routes ||--o{ student_transport : "assigned to"
shuttles ||--o{ student_transport : "assigned to"
shuttles ||--o{ location_tracking : "tracked by"

teachers ||--o{ notifications : "creates"
notifications ||--o{ notification_recipients : "sent to"
users ||--o{ notification_recipients : "receives"
teachers ||--o{ announcements : "creates"

@enduml
